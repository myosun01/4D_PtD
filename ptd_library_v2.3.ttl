ptd:H007_SlabEdge a ptd:HazardType ;
    rdfs:label "슬래브 단부"@ko ;
    ptd:hasReference ptd:REF_S2, ptd:REF_S3 ;
    rdfs:comment "개구부(hole)와 별개의 추락 시나리오. OSHA 1926 Subpart M이 unprotected sides/edges와 holes를 구분 규정, HSE HSG150 동일 [REF_S3, REF_S2]. 기존 엔진의 fall_edge 파생계산을 1급 타입으로 승격."@ko .
ptd:H008_ShoringCollapse a ptd:HazardType ;
    rdfs:label "거푸집·동바리 붕괴"@ko ;
    ptd:simulationProfile "collapse_zone" ;
    ptd:implementationStatus "planned" ;
    ptd:hasReference ptd:REF_S29, ptd:REF_S30 ;
    rdfs:comment "타설 중~양생 초기 동바리 존치 구간(하부층 포함) 체류 = 노출로 정의하는 collapse_zone 채널. 다층 4D 고유."@ko .
ptd:H009_DropZone a ptd:HazardType ;
