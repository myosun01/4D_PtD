# 자동 생성 파일 — 수정 금지. 원천: ptd_library_master_v1.xlsx (build_ttl_from_master.py)
# v2.3 증분: 국토안전관리원 위험요소 프로파일(2025.09.23) 스크리닝 결과 병합 (KE_K_* 15건)
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ptd:  <http://construction-safety.org/ptd-hoc-ontology#> .
<http://construction-safety.org/ptd-hoc-ontology> a owl:Ontology ;
    owl:versionInfo "2.3-generated" ;
    rdfs:comment "RC 골조 4D PtD 실행 가능 지식 라이브러리 — 마스터 표에서 생성. v2.3에서 KALIS 위험요소 프로파일 병합"@ko .

ptd:HazardType a owl:Class .
ptd:HoCLevel a owl:Class .
ptd:PtDAlternative a owl:Class .
ptd:SimulationRule a owl:Class .
ptd:Reference a owl:Class .
ptd:KnowledgeEntry a owl:Class .
ptd:RiskScenario a owl:Class .
ptd:CoverageCell a owl:Class .
ptd:AccidentType a owl:Class .
ptd:Trade a owl:Class .
ptd:LifecycleRuleTemplate a owl:Class .
ptd:ConflictResolution a owl:Class .
ptd:SpatialChangeRule a owl:Class ; rdfs:subClassOf ptd:SimulationRule .
ptd:AgentParameterRule a owl:Class ; rdfs:subClassOf ptd:SimulationRule .
ptd:TemporalRule a owl:Class ; rdfs:subClassOf ptd:SimulationRule .
ptd:ExecutableAlternative a owl:Class ; rdfs:subClassOf ptd:PtDAlternative .
ptd:isHigherThan a owl:ObjectProperty , owl:TransitiveProperty .
ptd:RiskAvoidance a ptd:HoCLevel ; ptd:isHigherThan ptd:Elimination .
ptd:Elimination a ptd:HoCLevel ; ptd:isHigherThan ptd:Substitution .
ptd:Substitution a ptd:HoCLevel ; ptd:isHigherThan ptd:EngineeringControls .
ptd:EngineeringControls a ptd:HoCLevel ; ptd:isHigherThan ptd:WarningSystems .
ptd:WarningSystems a ptd:HoCLevel ; ptd:isHigherThan ptd:AdministrativeControls .
ptd:AdministrativeControls a ptd:HoCLevel ; ptd:isHigherThan ptd:PPE .
ptd:PPE a ptd:HoCLevel .
