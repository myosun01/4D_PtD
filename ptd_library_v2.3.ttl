ptd:implementationStatus a owl:DatatypeProperty ;
    rdfs:comment "시뮬레이터 구현 단계: implemented | planned | not_applicable. 구 applicableInCurrentSimulator를 대체 — '적용 불가'가 아니라 '구현 순서'임을 명시"@ko .
ptd:kalisFrequency a owl:DatatypeProperty ;
    rdfs:comment "KALIS 위험요소 프로파일 내 해당 대책의 출현 빈도(건축·철근콘크리트+가설공사, 중복 제거 기준)"@ko .
ptd:designDeliverableType a owl:DatatypeProperty ;
    rdfs:comment "설계자가 산출하는 형태: 물리적조치 | 문서화 | 검증 | 검증·문서화"@ko .
ptd:fillsRung a owl:DatatypeProperty ;
    rdfs:comment "이 항목이 채우는 HoC 사다리의 빈 칸"@ko .

ptd:REF_KALIS_HRP a ptd:Reference ;
    ptd:sourceDocument "국토안전관리원. 위험요소 프로파일(Hazard Profile), 공공데이터포털 개방본 20250923. 전체 55,546건" ;
    ptd:evidenceLevel "official_data" ;
    rdfs:comment "원본 확보. 건축×(철근콘크리트공사+가설공사), RC 골조 관련 객체 한정, 중복 제거 후 3,297건을 스크리닝 대상으로 사용. 설계단계/시공단계 저감대책 컬럼이 대안 원천"@ko .

ptd:REF_COCHRANE_CD006251 a ptd:Reference ;
    ptd:sourceDocument "van der Molen HF, Basnet P, Hoonakker PLT, et al. (2018). Interventions to prevent injuries in construction workers. Cochrane Database Syst Rev, CD006251.pub4" ;
    ptd:evidenceLevel "systematic_review" ;
    rdfs:comment "건축물·시공의 안전설계를 포함한 권고 개입 대다수가 미평가 상태임을 명시. 상위 HoC 등급의 효과 계수가 부재하다는 근거이자, 메커니즘 기반 산출의 정당화 전거"@ko .

ptd:KALIS_HOC_FINDING a owl:NamedIndividual ;
    rdfs:label "KALIS 설계단계 저감대책의 HoC 분포"@ko ;
    ptd:hasReference ptd:REF_KALIS_HRP ;
    rdfs:comment "대상 3,297건 분류 결과 — 위험회피 0.0%, 제거 1.5%, 대체 5.6%, 공학적 24.4%, 경고 0.0%, 관리적 66.5%, 보호구 1.9%. 상위 3단 합계 7.1%. 산출물 유형은 검증·문서화 62.1%, 물리적조치 29.8%. 시뮬레이션 반영 가능 34.4%. 국내 설계안전성검토 제도의 표준 참조자료가 검증·문서화 중심의 관리적 대책에 편중되어 있음을 보임"@ko .

ptd:ACC_Pierce a ptd:AccidentType ;
    rdfs:label "찔림"@ko ;
    ptd:hasReference ptd:REF_KALIS_HRP ;
    rdfs:comment "v2.3 신설. 대상 범위 내 140건으로 넘어짐(134)보다 많음. 기인물은 돌출 연직철근이 지배적"@ko .

ptd:H010_ExposedRebar a ptd:HazardType ;
    rdfs:label "돌출 연직철근"@ko ;
    ptd:simulationProfile "puncture_zone" ;
    ptd:implementationStatus "planned" ;
    ptd:hasReference ptd:REF_KALIS_HRP ;
    rdfs:comment "배근 완료 후 안전캡 설치 또는 후속 부재 시공 시점까지 존치하는 관통상 위험. activeWindow 구조가 H001_FloorOpening과 동형"@ko .

ptd:H011_EquipmentCorridor a ptd:HazardType ;
    rdfs:label "차량·장비 주행 동선"@ko ;
    ptd:simulationProfile "equipment_corridor" ;
    ptd:implementationStatus "planned" ;
    ptd:hasReference ptd:REF_KALIS_HRP ;
    rdfs:comment "작업자 동선과 중첩되는 장비 주행 구역. 부딪힘 채널의 노출 단위는 중첩 구간 통과 횟수"@ko .

ptd:LCR_EXPOSED_REBAR a ptd:LifecycleRuleTemplate ;
    ptd:spawnTrigger "activity[trade=rebar, workType=vertical_placement, zone=Z].completed" ;
    ptd:despawnTrigger "activity[workType=cap_installation OR next_lift_formwork, zone=Z].completed" ;
    ptd:locationSelector "zone.verticalRebar" ;
    ptd:hasHazardType ptd:H010_ExposedRebar ;
    ptd:hasReference ptd:REF_KALIS_HRP .

ptd:CELL_Pierce_Rebar a ptd:CoverageCell ;
    ptd:hasAccidentType ptd:ACC_Pierce ;
    ptd:hasTrade ptd:TRD_Rebar ;
    ptd:priorityClass "P1" ;
    ptd:targetKnowledgeEntries 4 ;
    ptd:targetExecutableAlts 2 ;
    ptd:hasReference ptd:REF_KALIS_HRP ;
    rdfs:comment "v2.3 신설 셀"@ko .

ptd:SCN_20 a ptd:RiskScenario ;
