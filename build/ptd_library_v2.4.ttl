    rdfs:comment "v2.4 에서 타입 명시화. v2.3 은 이 개체를 hasHazardType 의 목적어로 참조하면서 클래스 선언을 누락했다. 라벨·구현상태는 원천에 없어 채우지 않았다."@ko .

ptd:KE_H001_01 a ptd:KnowledgeEntry ;
    ptd:addressesScenario ptd:SCN_04,
        ptd:SCN_05 ;
    ptd:adjudicationNote "물리적 조치(샤프트/축소/통합) 수반 → 승격. 노출 채널 dwell_time (근거어: 개구부/샤프트)."@ko ;
    ptd:alternativeDescription "설비 관통 개구부를 통합 샤프트로 집약 설계하여 슬래브 개구부 개소 수 자체를 축소"@ko ;
    ptd:designDecidable true ;
    ptd:exposureChannel "dwell_time" ;
    ptd:hasHoCLevel ptd:Elimination ;
    ptd:hasReference ptd:REF_S15P,
        ptd:REF_S4 ;
    ptd:hocRuleException false ;
    ptd:needsReview true ;
    ptd:promoted "TRUE" ;
    ptd:sourceEdition "2019" ;
    ptd:sourceType "학술" ;
    ptd:status "draft" ;
    rdfs:comment "원천 evidenceLevel='literature' — 목표 열거형에 대응 없음"@ko .

