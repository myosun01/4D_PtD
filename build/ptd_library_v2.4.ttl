ptd:REF_S25 a ptd:Reference ;
    ptd:evidenceLevel "official_statistics" ;
    ptd:sourceDocument "고용노동부 (2023). 2022년 재해조사 대상 사망사고 발생현황" ;
    rdfs:comment "보조 참고 (기준연도 2025 통일로 강등)"@ko .

