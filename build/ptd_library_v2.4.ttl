ptd:adjudicationNote a owl:DatatypeProperty ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:string .

ptd:cellTypeBasis a owl:DatatypeProperty ;
    rdfs:comment "appliesToCellType 을 무엇에서 유도했는지 (원천과 규칙). 추측 배정 방지용 감사 기록."@ko ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:string .

ptd:derivedBy a owl:DatatypeProperty ;
    rdfs:comment "이 개체를 생성한 파생 규칙의 출처 (스크립트·규칙 식별자)."@ko ;
    rdfs:range xsd:string .

ptd:designDecidable a owl:DatatypeProperty ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:boolean .

ptd:designDeliverableType a owl:DatatypeProperty ;
    rdfs:comment "설계자가 산출하는 형태: 물리적조치 | 문서화 | 검증 | 검증·문서화"@ko .

ptd:exposureChannel a owl:DatatypeProperty ;
    rdfs:comment "노출 산출 채널. dwell_time|passage_count|zone_occupancy|proximity|none"@ko ;
    rdfs:range xsd:string .

ptd:fillsRung a owl:DatatypeProperty ;
    rdfs:comment "이 항목이 채우는 HoC 사다리의 빈 칸"@ko .

ptd:geometryOperation a owl:DatatypeProperty ;
    rdfs:comment "relocate|resize|add|remove|none"@ko ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:string .

ptd:hocRuleException a owl:DatatypeProperty ;
    rdfs:comment "HoC 등급과 rule_type 의 대응이 예상과 다름. 오류가 아니라 검증 대상 가설의 관측 기록이다 — 분류를 수정하지 않는다."@ko ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:boolean .

ptd:ifcClass a owl:DatatypeProperty ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:string .

ptd:ifcPredefinedType a owl:DatatypeProperty ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:string .

ptd:implementationStatus a owl:DatatypeProperty ;
    rdfs:comment "시뮬레이터 구현 단계: implemented | planned | not_applicable. 구 applicableInCurrentSimulator를 대체 — '적용 불가'가 아니라 '구현 순서'임을 명시"@ko .

ptd:isHigherThan a owl:ObjectProperty,
        owl:TransitiveProperty .

ptd:kalisFrequency a owl:DatatypeProperty ;
    rdfs:comment "KALIS 위험요소 프로파일 내 해당 대책의 출현 빈도(건축·철근콘크리트+가설공사, 중복 제거 기준)"@ko ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:integer .

ptd:legalBasis a owl:DatatypeProperty ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:string .

ptd:legalVerifiedDate a owl:DatatypeProperty ;
    rdfs:comment "국가법령정보센터 현행본 대조일. 사람이 확인한 경우에만 존재."@ko ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:date .

ptd:needsReview a owl:DatatypeProperty ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:boolean .

ptd:parameterValue a owl:DatatypeProperty ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:string .

ptd:promoted a owl:DatatypeProperty ;
    rdfs:comment "실행층 승격 판정. TRUE|FALSE|UNSURE. UNSURE 는 미판정이며 확정값이 아니다."@ko ;
    rdfs:domain ptd:KnowledgeEntry ;
    rdfs:range xsd:string .

ptd:reasonCode a owl:DatatypeProperty ;
