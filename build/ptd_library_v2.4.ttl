    ptd:locationSelector "zone.openings" ;
    ptd:spawnTrigger "activity[trade=concrete_pour, workType=slab].completed" .

ptd:REF_COCHRANE_CD006251 a ptd:Reference ;
    ptd:evidenceLevel "systematic_review" ;
    ptd:sourceDocument "van der Molen HF, Basnet P, Hoonakker PLT, et al. (2018). Interventions to prevent injuries in construction workers. Cochrane Database Syst Rev, CD006251.pub4" ;
    rdfs:comment "건축물·시공의 안전설계를 포함한 권고 개입 대다수가 미평가 상태임을 명시. 상위 HoC 등급의 효과 계수가 부재하다는 근거이자, 메커니즘 기반 산출의 정당화 전거"@ko .

ptd:REF_KR_R333 a ptd:Reference ;
    ptd:evidenceLevel "law" ;
    ptd:sourceDocument "산업안전보건기준에 관한 규칙 제333조 (거푸집·동바리 조립·해체 등 작업 시의 준수사항)" ;
    rdfs:comment "원문 대조 완료"@ko .

ptd:REF_S11 a ptd:Reference ;
