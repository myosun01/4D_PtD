    ptd:adjudicationNote "v2.5 사람 판정: 채널 특정 불가 논거 해소 — 노출 채널은 재해유형이 결정 (재해유형 물체에맞음 → passage_count)"@ko ;
    ptd:alternativeDescription "고위험 작업(해체 등) 시간대에 필수 인원만 투입되도록 단계별(phased) 작업계획 수립 — 공존 노출의 시간적 분리"@ko ;
    ptd:designDecidable true ;
    ptd:exposureChannel "passage_count" ;
    ptd:hasHoCLevel ptd:Elimination ;
    ptd:hasReference ptd:REF_S4 ;
    ptd:hocRuleException false ;
    ptd:needsReview true ;
    ptd:promoted "TRUE" ;
    ptd:sourceEdition "2024" ;
    ptd:sourceType "지침" ;
    ptd:status "active" ;
    rdfs:comment "원천 promotionStatus=promoted"@ko .

ptd:KE_T_HS_04 a ptd:KnowledgeEntry ;
    ptd:adjudicationNote "v2.5 사람 판정: LCR_DROP_ZONE 템플릿 추가로 NO_CHANNEL 논거 소멸 (재해유형 물체에맞음 → passage_count)"@ko ;
    ptd:alternativeDescription "작업발판 일체형 거푸집 채택 — 해체 시 개별 부재 탈락·낙하 기회를 구조적으로 축소"@ko ;
    ptd:designDecidable true ;
    ptd:exposureChannel "passage_count" ;
    ptd:hasHoCLevel ptd:Substitution ;
    ptd:hasReference ptd:REF_KR_R331_3 ;
    ptd:hocRuleException true ;
    ptd:legalBasis "산업안전보건기준에 관한 규칙 제331조의3 (작업발판 일체형 거푸집의 안전조치)"@ko ;
    ptd:needsReview true ;
    ptd:promoted "TRUE" ;
    ptd:sourceType "법령" ;
    ptd:status "active" ;
    rdfs:comment "원천 evidenceLevel='law' — 목표 열거형에 대응 없음 | 작업발판 일체형 거푸집은 분명한 대체급이므로 HoC 유지. 다만 계수(휴리스틱)로 대신 작성된 것이므로 규칙 쪽이 잠정적 — 가설물 형상 확보 시 SpatialChangeRule 로 재작성. | 원천 promotionStatus=promoted"@ko .

ptd:PtDAlternative a owl:Class .

ptd:REF_KCS_142012 a ptd:Reference ;
    ptd:evidenceLevel "guideline" ;
    ptd:sourceDocument "KCS 14 20 12 「거푸집 및 동바리」 — 3.3.1(1)(5), 3.3.2(2), 표 3.3-1, 표 3.3-2" ;
    rdfs:comment "국가건설기준(KCS). 3.3.2(2) 연속 시공 다층 구조에서 타설층 포함 최소 3개 층 동바리 존치. v3.6 에서 LCR_SHORING_COLLAPSE despawn 규칙의 근거로 도입. 원문 대조 미완 — 조문 인용은 작업 지시서에 제시된 문구를 그대로 옮긴 것이다."@ko .

ptd:REF_KR_R330 a ptd:Reference ;
    ptd:evidenceLevel "law" ;
    ptd:sourceDocument "산업안전보건기준에 관한 규칙 제330조 (거푸집 및 동바리의 구조)" ;
    rdfs:comment "원문 대조 완료"@ko .

ptd:REF_KR_R331 a ptd:Reference ;
    ptd:evidenceLevel "law" ;
    ptd:sourceDocument "산업안전보건기준에 관한 규칙 제331조 (조립도)" ;
    rdfs:comment "원문 대조 완료"@ko .

ptd:REF_KR_R331_3 a ptd:Reference ;
    ptd:evidenceLevel "law" ;
    ptd:sourceDocument "산업안전보건기준에 관한 규칙 제331조의3 (작업발판 일체형 거푸집의 안전조치)" ;
    rdfs:comment "원문 대조 완료. 2023.11.14. 개정으로 구 제337조에서 이동"@ko .

ptd:REF_KR_R334 a ptd:Reference ;
    ptd:evidenceLevel "law" ;
    ptd:sourceDocument "산업안전보건기준에 관한 규칙 제334조 (콘크리트의 타설작업)" ;
    rdfs:comment "원문 대조 완료"@ko .

ptd:REF_KR_R44 a ptd:Reference ;
    ptd:evidenceLevel "law" ;
    ptd:sourceDocument "산업안전보건기준에 관한 규칙(고용노동부령 제450호) 제44조 (안전대의 부착설비 등)" ;
    rdfs:comment "원문 대조 완료"@ko .

ptd:REF_S1 a ptd:Reference ;
    ptd:sourceDocument "Szymberski (1997). Construction project safety planning. TAPPI J." .

ptd:REF_S10 a ptd:Reference ;
    ptd:sourceDocument "ANSI/ASSP Z590.3 Prevention through Design" .

ptd:REF_S12 a ptd:Reference ;
    ptd:sourceDocument "Mistikoglu & Gerek (2015). Procedia Engineering — guardrail effectiveness" .

ptd:REF_S13 a ptd:Reference ;
    ptd:sourceDocument "Chi, S. et al. (2014). Safety Science — administrative controls & risk tolerance" .

ptd:REF_S31 a ptd:Reference ;
    ptd:evidenceLevel "literature" ;
    ptd:sourceDocument "Insights into Concrete Forming, Reinforcing, and Pouring in Building Construction. Buildings 12(9):1303 (2022)" .

ptd:REF_S34 a ptd:Reference ;
    ptd:sourceDocument "Kang et al. (2017). Trends of fall accidents in the U.S. construction industry. JCEM" .

ptd:RULE_ADM_H001 a ptd:AgentParameterRule ;
    ptd:appliesToCellType "floor_opening" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "v1.2 ALT-H001-L4 승계 (ADM_RISK_TOL=0.15, ADM_FALL_FACTOR=0.59 정합)"@ko ;
    ptd:parameterValue "fallProbMultiplier=0.59" ;
    ptd:sensitivityTarget false .

ptd:RULE_CP_LIFT_LIMIT a ptd:AgentParameterRule ;
    ptd:appliesToCellType "collapse_zone" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "분할 타설의 동바리 하중 저감 → 붕괴확률 저감. 계수 문헌 미확보 — 민감도 분석 필수. 부수효과: 타설 액티비티 기간 증가(공기 트레이드오프를 시뮬레이션이 산출)"@ko ;
    ptd:parameterSourceType "heuristic" ;
    ptd:parameterValue "collapseProbMultiplier=0.50" ;
    ptd:sensitivityTarget true .

ptd:RULE_CP_NOENTRY a ptd:SpatialChangeRule ;
    ptd:applicabilityCondition "activity[trade=concrete_pour,zone=Z].started AND NOT cured(Z)" ;
    ptd:appliesToCellType "collapse_zone" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "하부 무출입 — 노출 제거와 우회비용이 창발적으로 산출됨"@ko ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "block_agent_entry" .

ptd:RULE_CP_PC a ptd:SpatialChangeRule ;
    ptd:applicabilityCondition "zone.method=precast" ;
    ptd:appliesToCellType "collapse_zone" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "PC 전환 구역은 현장 동바리 존치가 소멸 — 위험 인스턴스 자체 미생성"@ko ;
    ptd:parameterSourceType "design_change" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "remove_collapse_zone_for_precast_zones" .

ptd:RULE_CP_STRENGTH_VERIFY a ptd:TemporalRule ;
    ptd:cellTypeBasis "TemporalRule — 격자 대상 아님(별도 경로)"@ko ;
    ptd:parameterJustification "조기 해체 시나리오(SCN-09)의 조건부 차단 — 최초의 조건부(conditional) TemporalRule. 효과는 activeWindow 보장에서 창발"@ko ;
    ptd:parameterSourceType "schedule_logic" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "add precedence condition: formwork_stripping(Z) requires strength_verified(Z) [min curing lag enforced]" .

ptd:RULE_FE_GUARDRAIL a ptd:AgentParameterRule ;
    ptd:appliesToCellType "edge_cells" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "v1.2 ALT-H005-L3 승계: 단부 난간의 추락확률 계수 (ENG_FALL_FACTOR=0.10)"@ko ;
    ptd:parameterValue "fallProbMultiplier=0.10" ;
    ptd:sensitivityTarget false .

ptd:RULE_FE_METALDECK a ptd:SpatialChangeRule ;
    ptd:applicabilityCondition "zone.method=composite_metal_deck" ;
    ptd:appliesToCellType "collapse_zone" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "데크 공법 구역은 거푸집·동바리 위험 인스턴스(H008) 및 해체 액티비티 자체가 미생성. 데크 설치의 대체 위험은 한계로 기록"@ko ;
    ptd:parameterSourceType "design_change" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "remove_formwork_hazard_instances_for_deck_zones" .

ptd:RULE_FE_PLATFORM a ptd:AgentParameterRule ;
    ptd:appliesToCellType "elevated_work_zone" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "발판·틈새막음의 추락확률 저감 — v1.2 H005-L2 접근개선 계수(0.30) 준용. 클래스 전이이므로 민감도 분석 대상"@ko ;
    ptd:parameterValue "fallProbMultiplier=0.30" ;
    ptd:sensitivityTarget true .

ptd:RULE_FE_STAIR_EARLY a ptd:TemporalRule ;
    ptd:cellTypeBasis "TemporalRule — 격자 대상 아님(별도 경로)"@ko ;
    ptd:parameterJustification "효과는 수직동선 가용 시점 변화에서 창발 — 시뮬레이션 산출"@ko ;
    ptd:parameterSourceType "schedule_logic" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "advance activity[workType=permanent_stair]; VerticalLink.availableFromActivity := earlier" .

ptd:RULE_FS_CLOSURE_FIRST a ptd:TemporalRule ;
    ptd:cellTypeBasis "TemporalRule — 격자 대상 아님(별도 경로)"@ko ;
    ptd:parameterJustification "해체 시점의 개구부 재노출 창 제거 — 창발적 효과"@ko ;
    ptd:parameterSourceType "schedule_logic" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "set precedence: opening_closure(Z) FS-before formwork_stripping(Z)" .

ptd:RULE_H001_ELIM a ptd:SpatialChangeRule ;
    ptd:applicabilityCondition "opening.function=mep_penetration" ;
    ptd:appliesToCellType "floor_opening" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterSourceType "design_change" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "remove_hazard_instances" .

ptd:RULE_H001_GUARD a ptd:AgentParameterRule ;
    ptd:appliesToCellType "opening_edge_cells" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "난간 등 공학적 통제의 추락 감소 효과 — v1.2 계수 승계"@ko ;
    ptd:parameterSourceType "literature" ;
    ptd:parameterValue "fallProbMultiplier=0.10" ;
    ptd:sensitivityTarget false .

ptd:RULE_H001_RELOCATE a ptd:SpatialChangeRule ;
    ptd:appliesToCellType "floor_opening" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "v1.2 ALT-H001-L2 승계(재배치·축소 계열). 주 효과는 동선-개구부 교차 감소로 창발 — 배율은 잔여 근접노출 보정"@ko ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "relocate_openings_away_from_routes" .

ptd:RULE_H001_TEMPORAL a ptd:TemporalRule ;
    ptd:cellTypeBasis "TemporalRule — 격자 대상 아님(별도 경로)"@ko ;
    ptd:parameterJustification "효과는 배율이 아니라 activeWindow 단축에서 창발 — 시뮬레이션이 산출"@ko ;
    ptd:parameterSourceType "schedule_logic" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "set FS_lag(slab_pour -> opening_closure) = 0 days" .

ptd:RULE_HS_DEBRISNET a ptd:AgentParameterRule ;
    ptd:appliesToCellType "drop_zone" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "v1.2 ALT-H004-L3 승계: 낙하물 방지망의 falling-object exposure 계수"@ko ;
    ptd:parameterValue "hazardWeightMultiplier=0.35" ;
    ptd:sensitivityTarget false .

ptd:RULE_HS_GROUNDASM a ptd:SpatialChangeRule ;
    ptd:applicabilityCondition "assembly.prefabricable=true" ;
    ptd:appliesToCellType "elevated_work_zone" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "v1.2 ALT-H005-L1 승계: 지상 선조립 전환은 고소작업 구역 자체를 제거"@ko ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "remove_elevated_work_zone_convert_to_ground_task" .

ptd:RULE_HS_INTFORM a ptd:AgentParameterRule ;
    ptd:applicabilityCondition "activity.trade=formwork_stripping" ;
    ptd:appliesToCellType "drop_zone" ;
    ptd:cellTypeBasis "오기교정: v2.3 이월값 material_storage 는 적재구역을 가리켜 이 항목과 무관하다. directive_ko('작업발판 일체형 거푸집 — 해체 시 개별 부재 탈락·낙하 기회를 축소') 와 accident_type(물체에맞음)이 모두 낙하물 노출을 가리키므로 drop_zone 으로 교정. 전거: 산업안전보건기준에 관한 규칙 제331조의3 (legal_basis 열에 기재됨)."@ko ;
    ptd:parameterJustification "일체형 거푸집의 해체 중 부재 탈락 저감 — 계수 문헌 미확보, 민감도 분석 필수"@ko ;
    ptd:parameterSourceType "heuristic" ;
    ptd:parameterValue "materialProbMultiplier=0.50" ;
    ptd:sensitivityTarget true .

ptd:RULE_HS_PHASED a ptd:TemporalRule ;
    ptd:cellTypeBasis "TemporalRule — 격자 대상 아님(별도 경로)"@ko ;
    ptd:parameterJustification "공존 노출의 시간 분리 — 효과는 시뮬레이션이 직접 산출 (순환성 없음)"@ko ;
    ptd:parameterSourceType "schedule_logic" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "deconflict: shift co-located activities so overlap(stripping, other)=0" .

ptd:RULE_K_CA_02 a ptd:AgentParameterRule ;
    ptd:cellTypeBasis "적용 불가: proximity(끼임) 채널은 현재 zone 집합에 대응 유형이 없다"@ko ;
    ptd:parameterJustification "끼임 셀이 전부 TBM 교육이던 상태를 해소하는 첫 항목"@ko ;
    ptd:parameterSourceType "heuristic" ;
    ptd:sensitivityTarget true ;
    ptd:simulationAction "reduce_caught_prob_at_machine_cells" .

ptd:RULE_K_CA_03 a ptd:AgentParameterRule ;
    ptd:cellTypeBasis "적용 불가: proximity(끼임) 채널은 현재 zone 집합에 대응 유형이 없다"@ko ;
    ptd:parameterJustification "갱폼 사용 프로젝트에 한정 — applicabilityCondition 필요"@ko ;
    ptd:parameterSourceType "heuristic" ;
    ptd:sensitivityTarget true ;
    ptd:simulationAction "reduce_premature_release_prob" .

ptd:RULE_K_CP_07 a ptd:SpatialChangeRule ;
    ptd:appliesToCellType "collapse_zone" ;
    ptd:cellTypeBasis "R1 simulation_action='substitute_shoring_system_reduce_defect_derived_collapse_instances' 에 'shoring_system' 명시"@ko ;
    ptd:parameterJustification "기존 ALT_CP_PC(PC 전환)보다 비용·적용성이 낮은 대체 대안 — 대체 등급 내 비교 가능"@ko ;
    ptd:parameterSourceType "design_change" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "substitute_shoring_system_reduce_defect_derived_collapse_instances" .

ptd:RULE_K_CP_09 a ptd:TemporalRule ;
    ptd:cellTypeBasis "TemporalRule — 격자 대상 아님(별도 경로)"@ko ;
    ptd:parameterJustification "기존 RULE_HS_PHASED와 규칙 형식이 동일 — 통합 검토 가능"@ko ;
    ptd:parameterSourceType "schedule_logic" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "deconflict: enforce assembly/dismantling precedence order" .

ptd:RULE_K_FE_10 a ptd:SpatialChangeRule ;
    ptd:appliesToCellType "scaffold" ;
    ptd:cellTypeBasis "R1 simulation_action='substitute_scaffold_system_reduce_assembly_defect_instances' 에 'scaffold_system' 명시"@ko ;
    ptd:parameterJustification "추락·붕괴 두 채널에 동시 작용하는 최초의 대안. 채널 간 상호작용 검증 케이스로 활용 가능"@ko ;
    ptd:parameterSourceType "design_change" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "substitute_scaffold_system_reduce_assembly_defect_instances" .

ptd:RULE_K_FE_11 a ptd:AgentParameterRule ;
    ptd:appliesToCellType "collapse_zone" ;
    ptd:cellTypeBasis "R2 exposure_channel='zone_occupancy' — 이 프로젝트 zone 집합에서 1:1 (H008 뿐)"@ko ;
    ptd:parameterJustification "계수 미확보 — sensitivityTarget 지정 필요"@ko ;
    ptd:parameterSourceType "heuristic" ;
    ptd:sensitivityTarget true ;
    ptd:simulationAction "reduce_collapse_prob_for_prepared_ground" .

ptd:RULE_K_FS_02 a ptd:TemporalRule ;
    ptd:cellTypeBasis "TemporalRule — 격자 대상 아님(별도 경로)"@ko ;
    ptd:parameterJustification "기존 LCR_SHORING_COLLAPSE의 despawnTrigger와 직접 대응 — 라이브러리와 시뮬레이터 정합 지점"@ko ;
    ptd:parameterSourceType "schedule_logic" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "set precedence: formwork_stripping(Z) requires retention_period_elapsed(Z)" .

ptd:RULE_K_HS_05 a ptd:SpatialChangeRule ;
    ptd:appliesToCellType "material_storage" ;
    ptd:cellTypeBasis "R1 simulation_action='cap_material_stack_height_limit_spawn_volume' 에 'material_stack' 명시"@ko ;
    ptd:parameterJustification "기존 RULE_TRIP_STORAGE(재배치)와 달리 적치 '양'을 제한 — 별개 규칙"@ko ;
    ptd:parameterSourceType "design_change" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "cap_material_stack_height_limit_spawn_volume" .

ptd:RULE_K_HS_06 a ptd:SpatialChangeRule ;
    ptd:appliesToCellType "drop_zone" ;
    ptd:cellTypeBasis "R1 simulation_action='block_agent_entry_to_drop_influence_zone' 에 'drop_influence_zone' 명시"@ko ;
    ptd:parameterJustification "H009_DropZone 채널 구현 시 직접 대응"@ko ;
    ptd:parameterSourceType "design_change" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "block_agent_entry_to_drop_influence_zone" .

ptd:RULE_K_RB_02 a ptd:SpatialChangeRule ;
    ptd:cellTypeBasis "R1 미결: simulation_action 의 'walkway' 는 대상 격자를 특정하지 않는다"@ko ;
    ptd:parameterJustification "동선을 직접 바꾸는 SpatialChangeRule — 효과가 계수가 아닌 창발로 산출되는 공학적 등급 사례"@ko ;
    ptd:parameterSourceType "design_change" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "add_dedicated_walkway_reroute_agents" .

ptd:RULE_K_RB_03 a ptd:AgentParameterRule ;
    ptd:cellTypeBasis "R2 미결: exposure_channel='passage_count' 는 복수 위험유형에 대응해 모호 (accident_type='물체에맞음' 만으로는 결정 불가)"@ko ;
    ptd:parameterJustification "KALIS 내 단일 대책 중 2위 빈도. 계수 미확보 — sensitivityTarget"@ko ;
    ptd:parameterSourceType "heuristic" ;
    ptd:sensitivityTarget true ;
    ptd:simulationAction "reduce_material_topple_prob_for_braced_rebar" .

ptd:RULE_K_ST_03 a ptd:SpatialChangeRule ;
    ptd:appliesToCellType "equipment_corridor" ;
    ptd:cellTypeBasis "R1 simulation_action='separate_worker_and_equipment_corridors' 에 'equipment_corridor' 명시"@ko ;
    ptd:parameterJustification "부딪힘 7건 중 5건이 TBM이던 상태를 해소. 장비 에이전트 도입 시 유효"@ko ;
    ptd:parameterSourceType "design_change" ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "separate_worker_and_equipment_corridors" .

ptd:RULE_K_TR_08 a ptd:AgentParameterRule ;
    ptd:cellTypeBasis "R2 미결: exposure_channel='passage_count' 는 복수 위험유형에 대응해 모호 (accident_type='넘어짐' 만으로는 결정 불가)"@ko ;
    ptd:parameterJustification "기존 KE_M_Trip_MatHandling_02와 중복 — 통합하고 evidenceLevel을 heuristic→official_data로 승격"@ko ;
    ptd:parameterSourceType "heuristic" ;
    ptd:sensitivityTarget true ;
    ptd:simulationAction "reduce_trip_prob_for_lit_routes" .

ptd:RULE_PPE_H001 a ptd:AgentParameterRule ;
    ptd:appliesToCellType "floor_opening" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "v1.2 ALT-H001-L5 승계 (PPE_FATAL_FACTOR=0.27): 노출 유지, 심각도만 감소 — SWR 지표 필요성의 근원"@ko ;
    ptd:parameterValue "fatalityMultiplier=0.27;injuryMultiplier=1.00" ;
    ptd:sensitivityTarget false .

ptd:RULE_TRIP_LIGHT a ptd:AgentParameterRule ;
    ptd:appliesToCellType "route" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "조도·시인성의 걸림 확률 저감 — 계수 문헌 미확보. CSI 사례의 조도 75lux 기준 참조"@ko ;
    ptd:parameterSourceType "heuristic" ;
    ptd:parameterValue "tripProbMultiplier=0.80" ;
    ptd:sensitivityTarget true .

ptd:RULE_TRIP_ROUTE a ptd:SpatialChangeRule ;
    ptd:appliesToCellType "route" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "통로 셀에 적재물 생성 금지 — 걸림원 노출 재분배가 창발적으로 산출"@ko ;
    ptd:sensitivityTarget false ;
    ptd:simulationAction "protect_route_corridor_exclude_material_spawn" .

ptd:RULE_TRIP_STORAGE a ptd:SpatialChangeRule ;
    ptd:appliesToCellType "material_storage" ;
    ptd:cellTypeBasis "v2.3 정본 값 (유도하지 않음 — 정본이 우선)"@ko ;
    ptd:parameterJustification "v1.2 ALT-H004-L2 승계: 저교통 구역 재배치의 overlap 감소 계수"@ko ;
    ptd:sensitivityTarget true ;
    ptd:simulationAction "relocate_storage_zone_reduce_overlap_with_walkway" .

